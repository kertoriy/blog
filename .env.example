# 复制为 .env 后按需修改
# cp .env.example .env

# Docker 数据目录（Windows 示例，路径中的 @ 无需转义）
DOCKER_DATA_ROOT=D:/ComputerData/DockerData/ker-edit-blog

# ---------- MySQL ----------
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=Dev123456@
MYSQL_DATABASE=ker_edit_blog
MYSQL_USER=ker_blog
MYSQL_PASSWORD=Dev123456@

# Nuxt 连接（本机访问容器映射端口）
MYSQL_HOST=127.0.0.1

# ---------- MongoDB ----------
MONGODB_PORT=27017
MONGODB_ROOT_USER=root
MONGODB_ROOT_PASSWORD=Dev123456@
MONGODB_DATABASE=ker_edit_blog
MONGODB_USER=ker_blog
MONGODB_PASSWORD=Dev123456@
MONGODB_HOST=127.0.0.1
# 应用账号连接（与 docker/mongo/init/01-init-db.js 一致）
MONGODB_URI=mongodb://ker_blog:Dev123456%40@127.0.0.1:27017/ker_edit_blog?authSource=ker_edit_blog

# ---------- Redis ----------
REDIS_PORT=6379
REDIS_PASSWORD=Dev123456@
REDIS_HOST=127.0.0.1

# ---------- 后台鉴权（后续登录接口使用，勿提交真实哈希） ----------
# ADMIN_PASSWORD_HASH=
