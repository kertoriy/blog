# 默认监听 :80（本地调试或前置反代模式）
# 生产环境在 .env 中设置 SITE_ADDRESS=kertoriy.dev 即可由 Caddy 自动签发并续期 Let's Encrypt HTTPS 证书
{$SITE_ADDRESS::80} {
	root * /srv/blog
	encode zstd gzip

	# 基础安全响应头
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Nuxt 带内容哈希的构建资源长期强缓存（1 年 immutable）
	@immutable path /_nuxt/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# 图片、图标与样式等静态素材中长期缓存（7 天）
	@assets path *.svg *.png *.jpg *.jpeg *.webp *.ico *.woff2 *.css *.js
	header @assets Cache-Control "public, max-age=604800"

	# HTML 入口协商缓存，确保每次发版第一时间生效
	@html path / *.html
	header @html Cache-Control "no-cache"

	# 优先命中静态预渲染目录与文件，回退至 Nuxt SPA 入口
	try_files {path} {path}/ /200.html /index.html
	file_server

	handle_errors {
		@404 expression `{err.status_code} == 404`
		rewrite @404 /404.html
		file_server
	}
}
